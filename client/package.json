{
  "name": "client",
  "version": "0.2.1",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/version.mjs",
    "test": "ng test",
    "test:cov": "ng test --coverage",
    "pretypecheck": "node scripts/version.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\" \"scripts/*.mjs\" \"*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\" \"scripts/*.mjs\" \"*.ts\" \"*.mjs\"",
    "lint": "ng lint && npm run lint:styles && npm run lint:no-mat-color && npm run check:form-fields && npm run check:spinner-labels",
    "lint:fix": "ng lint --fix && npm run lint:styles -- --fix",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:no-mat-color": "node scripts/lint-no-mat-color.mjs",
    "check:form-fields": "node scripts/check-form-fields.mjs",
    "check:spinner-labels": "node scripts/check-spinner-labels.mjs",
    "check:imports": "node ../scripts/check-imports.mjs",
    "check:nginx-log": "node scripts/check-nginx-log-redaction.mjs",
    "check:nginx-headers": "node scripts/check-nginx-headers.mjs",
    "audit:ci": "node ../scripts/audit-ci.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:auth": "npm run build",
    "test:e2e:auth": "playwright test e2e/auth",
    "pretest:e2e:users": "npm run build",
    "test:e2e:users": "playwright test e2e/users",
    "pretest:e2e:ui": "npm run build",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node scripts/version.mjs",
    "prepare": "cd .. && husky client/.husky",
    "release": "commit-and-tag-version",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@casl/ability": "^6.8.1",
    "@jsverse/transloco": "^8.4.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "overrides": {
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "serve": {
      "compression": "^1.8.2"
    }
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "baseline-browser-mapping": "^2.11.27",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^7.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false,
    "unrs-resolver": false
  }
}
