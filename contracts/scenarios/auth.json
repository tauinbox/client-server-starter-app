{
  "scenarios": [
    {
      "name": "a new account registers",
      "route": "POST /api/v1/auth/register",
      "auth": "none",
      "body": {
        "email": "$newEmail",
        "password": "$password",
        "name": "Scenario Owner"
      },
      "expect": {
        "status": 201,
        "errorKey": null,
        "audit": [
          "USER_REGISTER"
        ]
      }
    },
    {
      "name": "a password signs in",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "a locked account may not sign in",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "state": [
        "locked-actor"
      ],
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 423,
        "errorKey": "errors.auth.accountLocked",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "account_locked",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "an unverified address may not sign in",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "state": [
        "unverified-actor"
      ],
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 403,
        "errorKey": "errors.auth.emailNotVerified",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "email_not_verified",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "a deactivated account may not sign in with a password",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "state": [
        "deactivated-actor"
      ],
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.invalidCredentials",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "invalid_credentials",
            "target": "none"
          }
        ]
      }
    },
    {
      "name": "a soft-deleted account may not sign in with a password",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "state": [
        "deleted-actor"
      ],
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.invalidCredentials",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "invalid_credentials",
            "target": "none"
          }
        ]
      }
    },
    {
      "name": "a password signs in after a sign-out everywhere",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "state": [
        "revoked-actor"
      ],
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "an account with no password may not sign in with a password",
      "route": "POST /api/v1/auth/login",
      "actor": "user",
      "auth": "none",
      "state": [
        "passwordless-actor"
      ],
      "body": {
        "email": "$email",
        "password": "$password"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.invalidCredentials",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "invalid_credentials",
            "target": "none"
          }
        ]
      }
    },
    {
      "name": "a mailed link verifies the address",
      "route": "POST /api/v1/auth/verify-email",
      "actor": "user",
      "auth": "none",
      "state": [
        "unverified-actor",
        "verification-token"
      ],
      "body": {
        "token": "$verificationToken"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "EMAIL_VERIFIED"
        ]
      }
    },
    {
      "name": "an unverified address asks for a new link",
      "route": "POST /api/v1/auth/resend-verification",
      "actor": "user",
      "auth": "none",
      "state": [
        "unverified-actor"
      ],
      "body": {
        "email": "$email"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "EMAIL_VERIFICATION_RESEND"
        ]
      }
    },
    {
      "name": "a forgotten password asks for a reset link",
      "route": "POST /api/v1/auth/forgot-password",
      "actor": "user",
      "auth": "none",
      "body": {
        "email": "$email"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "PASSWORD_RESET_REQUEST"
        ]
      }
    },
    {
      "name": "a reset link sets a new password",
      "route": "POST /api/v1/auth/reset-password",
      "actor": "user",
      "auth": "none",
      "state": [
        "reset-token"
      ],
      "body": {
        "token": "$resetToken",
        "password": "$newPassword"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "PASSWORD_RESET_COMPLETE"
        ]
      }
    },
    {
      "name": "a reset link verifies an unverified address",
      "route": "POST /api/v1/auth/reset-password",
      "actor": "user",
      "auth": "none",
      "state": [
        "unverified-actor",
        "reset-token"
      ],
      "body": {
        "token": "$resetToken",
        "password": "$newPassword"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "PASSWORD_RESET_COMPLETE",
          "EMAIL_VERIFIED"
        ]
      }
    },
    {
      "name": "a refresh cookie rotates the session",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie"
      ],
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": []
      }
    },
    {
      "name": "the refresh cookie of a deactivated account is refused and audited",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie",
        "deactivated-actor"
      ],
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.userDeactivated",
        "audit": [
          {
            "action": "TOKEN_REFRESH_FAILURE",
            "reason": "user_deactivated",
            "target": "none"
          }
        ]
      }
    },
    {
      "name": "the refresh cookie of a soft-deleted account is refused and audited",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie",
        "deleted-actor"
      ],
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.userNotFound",
        "audit": [
          {
            "action": "TOKEN_REFRESH_FAILURE",
            "reason": "user_not_found",
            "target": "none"
          }
        ]
      }
    },
    {
      "name": "a sign-out everywhere ends the refresh cookie",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie",
        "revoked-actor"
      ],
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.invalidRefreshToken",
        "audit": []
      }
    },
    {
      "name": "a lock keeps the session of a refresh cookie",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie",
        "locked-actor"
      ],
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": []
      }
    },
    {
      "name": "an unverified address keeps the session of a refresh cookie",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie",
        "unverified-actor"
      ],
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": []
      }
    },
    {
      "name": "an account with no password keeps the session of a refresh cookie",
      "route": "POST /api/v1/auth/refresh-token",
      "actor": "user",
      "auth": "none",
      "state": [
        "refresh-cookie",
        "passwordless-actor"
      ],
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": []
      }
    },
    {
      "name": "a session signs out",
      "route": "POST /api/v1/auth/logout",
      "actor": "user",
      "auth": "bearer",
      "state": [
        "refresh-cookie"
      ],
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGOUT"
        ]
      }
    },
    {
      "name": "a name change needs no factor",
      "route": "PATCH /api/v1/auth/profile",
      "actor": "user",
      "auth": "bearer",
      "body": {
        "name": "Renamed Owner"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": []
      }
    },
    {
      "name": "the current password starts an email change",
      "route": "POST /api/v1/auth/profile/email/initiate",
      "actor": "user",
      "auth": "bearer",
      "body": {
        "newEmail": "$newEmail",
        "currentPassword": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_EMAIL_CHANGE_REQUEST"
        ]
      }
    },
    {
      "name": "an account with no role may not change its email",
      "route": "POST /api/v1/auth/profile/email/initiate",
      "actor": "user-no-roles",
      "auth": "bearer",
      "body": {
        "newEmail": "$newEmail",
        "currentPassword": "$password"
      },
      "expect": {
        "status": 403,
        "errorKey": "errors.general.insufficientPermissions",
        "audit": [
          "PERMISSION_CHECK_FAILURE"
        ]
      }
    },
    {
      "name": "the mailed link confirms an email change",
      "route": "POST /api/v1/auth/profile/email/confirm",
      "actor": "user",
      "auth": "none",
      "state": [
        "email-change-token"
      ],
      "body": {
        "token": "$emailChangeToken"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_EMAIL_CHANGE_COMPLETE"
        ]
      }
    },
    {
      "name": "the current password starts an authenticator setup",
      "route": "POST /api/v1/auth/mfa/setup",
      "actor": "user",
      "auth": "bearer",
      "body": {
        "currentPassword": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": []
      }
    },
    {
      "name": "a code of the new authenticator enables it",
      "route": "POST /api/v1/auth/mfa/enable",
      "actor": "user",
      "auth": "bearer",
      "state": [
        "mfa-setup"
      ],
      "body": {
        "code": "$setupCode"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "MFA_ENABLE"
        ]
      }
    },
    {
      "name": "the current password disables the authenticator",
      "route": "POST /api/v1/auth/mfa/disable",
      "actor": "user-mfa",
      "auth": "bearer",
      "body": {
        "currentPassword": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "MFA_DISABLE"
        ]
      }
    },
    {
      "name": "each wrong code writes a step-up row and a challenge row",
      "route": "POST /api/v1/auth/mfa/disable",
      "actor": "user-mfa",
      "auth": "bearer",
      "body": {
        "code": "000000"
      },
      "repeat": 4,
      "expect": {
        "status": 403,
        "errorKey": "errors.auth.mfaStepUpInvalidCode",
        "audit": [
          "STEP_UP_FAILURE",
          "MFA_CHALLENGE_FAILURE",
          "STEP_UP_FAILURE",
          "MFA_CHALLENGE_FAILURE",
          "STEP_UP_FAILURE",
          "MFA_CHALLENGE_FAILURE",
          "STEP_UP_FAILURE",
          "MFA_CHALLENGE_FAILURE"
        ]
      }
    },
    {
      "name": "the wrong code that bars the authenticator is audited too",
      "route": "POST /api/v1/auth/mfa/disable",
      "actor": "user-mfa",
      "auth": "bearer",
      "state": [
        "step-up-code-failures"
      ],
      "body": {
        "code": "000000"
      },
      "expect": {
        "status": 423,
        "errorKey": "errors.auth.mfaStepUpLocked",
        "audit": [
          "MFA_CHALLENGE_FAILURE",
          "STEP_UP_FAILURE"
        ]
      }
    },
    {
      "name": "the current password replaces the recovery codes",
      "route": "POST /api/v1/auth/mfa/recovery-codes",
      "actor": "user-mfa",
      "auth": "bearer",
      "body": {
        "currentPassword": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "MFA_RECOVERY_CODES_REGENERATED"
        ]
      }
    },
    {
      "name": "the current password ends the other sessions",
      "route": "DELETE /api/v1/auth/sessions",
      "actor": "user",
      "auth": "bearer",
      "state": [
        "second-session"
      ],
      "body": {
        "currentPassword": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "SESSION_REVOKE"
        ]
      }
    },
    {
      "name": "the current password ends one other session",
      "route": "DELETE /api/v1/auth/sessions/1",
      "path": "/api/v1/auth/sessions/$otherSessionId",
      "actor": "user",
      "auth": "bearer",
      "state": [
        "second-session"
      ],
      "body": {
        "currentPassword": "$password"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "SESSION_REVOKE"
        ]
      }
    },
    {
      "name": "a code finishes a sign-in that a password started",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "the pending token of a deactivated account is refused and audited",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "deactivated-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.mfaInvalidPendingToken",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "account_deactivated",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "the pending token of a soft-deleted account is refused and audited",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "deleted-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.mfaInvalidPendingToken",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "account_not_found",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "a sign-out everywhere ends the pending token of a code",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "revoked-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.mfaInvalidPendingToken",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "session_revoked",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "a code finishes a sign-in that a lock follows",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "locked-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "a code finishes a sign-in of an address that is not verified",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "unverified-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "a code finishes a sign-in of an account with no password",
      "route": "POST /api/v1/auth/mfa/verify",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "passwordless-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "code": "$code"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "a recovery code finishes a sign-in that a password started",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "recoveryCode": "$recoveryCode"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "MFA_RECOVERY_CODE_USED",
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "the recovery pending token of a deactivated account is refused and audited",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "deactivated-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "recoveryCode": "$recoveryCode"
      },
      "expect": {
