            "reason": "account_deactivated",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "the recovery pending token of a soft-deleted account is refused and audited",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "deleted-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "recoveryCode": "$recoveryCode"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.mfaInvalidPendingToken",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "account_not_found",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "a sign-out everywhere ends the pending token of a recovery code",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "revoked-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "recoveryCode": "$recoveryCode"
      },
      "expect": {
        "status": 401,
        "errorKey": "errors.auth.mfaInvalidPendingToken",
        "audit": [
          {
            "action": "USER_LOGIN_FAILURE",
            "reason": "session_revoked",
            "target": "actor"
          }
        ]
      }
    },
    {
      "name": "a recovery code finishes a sign-in that a lock follows",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "locked-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "recoveryCode": "$recoveryCode"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "MFA_RECOVERY_CODE_USED",
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "a recovery code finishes a sign-in of an address that is not verified",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "unverified-actor"
      ],
      "body": {
        "mfaToken": "$mfaToken",
        "recoveryCode": "$recoveryCode"
      },
      "expect": {
        "status": 200,
        "errorKey": null,
        "audit": [
          "MFA_RECOVERY_CODE_USED",
          "USER_LOGIN_SUCCESS"
        ]
      }
    },
    {
      "name": "a recovery code finishes a sign-in of an account with no password",
      "route": "POST /api/v1/auth/mfa/recovery",
      "actor": "user-mfa",
      "auth": "none",
      "state": [
        "mfa-challenge",
        "passwordless-actor"
      ],
      "body": {
