{
  "name": "server",
  "version": "0.2.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.ts\" \"*.ts\" \"../shared/src/**/*.ts\" \"../*.mjs\" \"../scripts/*.mjs\" \"../.lintstagedrc.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.ts\" \"*.ts\" \"../shared/src/**/*.ts\" \"../*.mjs\" \"../scripts/*.mjs\" \"../.lintstagedrc.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/server/src/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:run": "typeorm-seeding seed -d dist/server/src/postgres-data-source.js dist/server/src/seeders/*.js",
    "migrations:gen": "npx typeorm-ts-node-esm migration:generate -d dist/server/src/postgres-data-source.js",
    "migrations:run": "npx typeorm-ts-node-esm migration:run -d dist/server/src/postgres-data-source.js",
    "migrations:revert": "npx typeorm-ts-node-esm migration:revert -d dist/server/src/postgres-data-source.js",
    "check:routes": "ts-node scripts/check-routes.ts",
    "check:enums": "ts-node scripts/check-enums.ts",
    "check:permissions": "ts-node scripts/check-permissions.ts",
    "check:i18n": "ts-node -r tsconfig-paths/register scripts/check-i18n-keys.ts",
    "check:imports": "node ../scripts/check-imports.mjs",
    "check:role-conditions": "ts-node scripts/check-existing-role-conditions.ts",
    "check:grant-scope": "ts-node -r tsconfig-paths/register scripts/check-grant-scope.ts",
    "generate:subjects": "ts-node scripts/generate-subjects.ts",
    "audit:ci": "node ../scripts/audit-ci.mjs"
  },
  "dependencies": {
    "@a2seven/yoo-checkout": "^1.1.4",
    "@casl/ability": "^6.8.1",
    "@jorgebodega/typeorm-seeding": "^7.1.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.3",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.5",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-vkontakte": "^0.5.0",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "0.3.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^7.0.12",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-vkontakte": "^1.3.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "minimatch@>=9.0.0 <9.0.7": {
      ".": "9.0.7",
      "brace-expansion": "^5.0.9"
    },
    "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
    "multer": ">=2.2.0",
    "form-data": ">=4.0.6",
    "path-to-regexp": "8.4.0",
    "lodash": "^4.18.1",
    "@a2seven/yoo-checkout": {
      "axios": "$axios"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/index.ts",
      "!main.ts",
      "!postgres-data-source.ts",
      "!postgres.config.ts",
      "!cors-options.ts",
      "!modules/core/configuration.ts",
      "!migrations/**",
      "!seeders/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 60,
        "branches": 60,
        "functions": 50,
        "lines": 60
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/shared/(.*)$": "<rootDir>/../../shared/src/$1",
      "^temporal-polyfill$": "<rootDir>/../node_modules/temporal-polyfill"
    },
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "require",
        "default"
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*(@scure|@noble))"
    ]
  }
}
