{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2025", "dom"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/utils/cursor.ts",
    "src/utils/feature-flag-evaluator.ts",
    "src/utils/request-scenarios.ts",
    "src/utils/time.ts"
  ]
}
