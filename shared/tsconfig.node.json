{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2025"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["../server/node_modules/@types"],
    "types": ["node"],
    "paths": {
      "temporal-polyfill": ["../server/node_modules/temporal-polyfill"]
    }
  },
  "files": [
    "src/utils/cursor.ts",
    "src/utils/feature-flag-evaluator.ts",
    "src/utils/request-scenarios.ts",
    "src/utils/time.ts"
  ]
}
