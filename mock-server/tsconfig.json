{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "outDir": "./dist",
    "strict": true,
    "noPropertyAccessFromIndexSignature": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@app/shared/*": ["../shared/src/*"],
      "temporal-polyfill": ["./node_modules/temporal-polyfill"]
    },
    "rootDir": ".."
  },
  "include": ["src/**/*", "../shared/src/**/*", "eslint.config.ts"],
  "exclude": ["node_modules", "dist"]
}
