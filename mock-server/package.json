{
  "name": "mock-server",
  "version": "0.2.1",
  "private": true,
  "description": "In-memory mock backend for development and E2E testing",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "start:dev": "node --watch -r ts-node/register/transpile-only -r tsconfig-paths/register src/index.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "check:imports": "node ../scripts/check-imports.mjs",
    "audit:ci": "node ../scripts/audit-ci.mjs"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@faker-js/faker": "^10.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "temporal-polyfill": "^1.0.5",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "^8.0.0"
    }
  },
  "allowScripts": {
    "unrs-resolver": false,
    "@parcel/watcher": false
  }
}
