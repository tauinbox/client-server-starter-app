# Compose env file of a data-region cell other than intl.
# Copy it to cells/<region>/.env, and copy server/.env.example to
# cells/<region>/server/.env. Both copies are gitignored. Run the cell only
# through scripts/cell.sh, which refuses this file when CELL is wrong.
# See README.md "Data-region cells".

# The region of the cell, a value of DATA_REGIONS. docker-compose.yml derives
# from it the project (nexus-<region>), the database volume
# (nexus-<region>_postgres_data_18), the proxy network (nexus-<region>-proxy),
# the proxy aliases (nexus-<region>-server, -client, -grafana) and DATA_REGION.
CELL=ru

# The loopback port of the client. 4200 belongs to the intl cell.
CLIENT_HOST_PORT=4201

# The database of this cell. Use a password of its own, never the one of
# another cell. Keep these equal to DB_NAME, DB_USER and DB_PASSWORD in
# cells/<region>/server/.env.
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=

# The captcha vendor. No vendor in Russia is integrated yet, so a ru cell
# keeps it empty and has the rate limiter only.
CAPTCHA_PROVIDER=

GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=
ALERT_WEBHOOK_URL=

SERVER_IMAGE=ghcr.io/your-username/nexus-server:latest
CLIENT_IMAGE=ghcr.io/your-username/nexus-client:latest
